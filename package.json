{
  "name": "paygate-to",
  "version": "1.0.0",
  "description": "Node.js SDK for PayGate.to: card and crypto payments without KYC, instant payouts to your own wallet, and signed callback verification.",
  "keywords": [
    "paygate",
    "paygate.to",
    "payments",
    "payment gateway",
    "crypto",
    "bitcoin",
    "usdc",
    "usdt",
    "credit card",
    "no kyc",
    "white label"
  ],
  "homepage": "https://paygate.to/docs/sdk/node/",
  "bugs": "https://github.com/paygate-to/paygate-node/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paygate-to/paygate-node.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/package-types.mjs",
    "test": "npm run build && node scripts/test.mjs test/unit",
    "test:integration": "npm run build && node scripts/test.mjs test/integration",
    "typecheck": "tsc -p tsconfig.esm.json --noEmit",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
